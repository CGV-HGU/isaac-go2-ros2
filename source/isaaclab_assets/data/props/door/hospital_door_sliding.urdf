<?xml version="1.0" encoding="utf-8"?>
<robot name="hospital_door_sliding">
  <!-- Fixed world frame anchor -->
  <link name="door_world_anchor"/>

  <joint name="anchor_to_frame_joint" type="fixed">
    <parent link="door_world_anchor"/>
    <child link="door_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Overhead Track & Outer Frame -->
  <link name="door_frame">
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0.45 0 1.05" rpy="0 0 0"/>
      <inertia ixx="1.2" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.2"/>
    </inertial>
    <visual>
      <origin xyz="-0.03 0 1.05" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 2.10"/></geometry>
      <material name="frame_mat"><color rgba="0.80 0.82 0.86 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.03 0 1.05" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 2.10"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.93 0 1.05" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 2.10"/></geometry>
      <material name="frame_mat"><color rgba="0.80 0.82 0.86 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.93 0 1.05" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 2.10"/></geometry>
    </collision>
    <!-- Extended sliding overhead rail -->
    <visual>
      <origin xyz="0.05 0 2.12" rpy="0 0 0"/>
      <geometry><box size="1.90 0.10 0.06"/></geometry>
      <material name="frame_mat"><color rgba="0.75 0.78 0.82 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.05 0 2.12" rpy="0 0 0"/>
      <geometry><box size="1.90 0.10 0.06"/></geometry>
    </collision>
  </link>

  <!-- Prismatic Sliding Rail Joint (slides toward -X from 0.0 to -0.82m, or +0.0..0.82m along -X axis) -->
  <joint name="door_hinge" type="prismatic">
    <parent link="door_frame"/>
    <child link="door_leaf"/>
    <origin xyz="0.0 0 0.02" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.82" effort="80.0" velocity="1.2"/>
    <dynamics damping="8.0" friction="0.3"/>
  </joint>

  <link name="door_leaf">
    <inertial>
      <mass value="14.0"/>
      <origin xyz="0.45 0 1.0" rpy="0 0 0"/>
      <inertia ixx="4.5" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="5.2"/>
    </inertial>
    <visual>
      <origin xyz="0.45 0 1.0" rpy="0 0 0"/>
      <geometry><box size="0.90 0.04 2.0"/></geometry>
      <material name="door_mat"><color rgba="0.72 0.85 0.92 0.85"/></material>
    </visual>
    <collision>
      <origin xyz="0.45 0 1.0" rpy="0 0 0"/>
      <geometry><box size="0.90 0.04 2.0"/></geometry>
    </collision>
  </link>

  <!-- Vertical Bar Handle (minimal latch travel for unified joint schema) -->
  <joint name="door_handle_joint" type="revolute">
    <parent link="door_leaf"/>
    <child link="door_handle"/>
    <origin xyz="0.80 -0.04 0.95" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.05" effort="10.0" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="door_handle">
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 -0.04 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.04 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.22"/></geometry>
      <material name="handle_silver"><color rgba="0.88 0.88 0.90 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 -0.04 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.22"/></geometry>
    </collision>
  </link>
</robot>
