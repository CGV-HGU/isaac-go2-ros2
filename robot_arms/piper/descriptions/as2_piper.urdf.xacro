<?xml version="1.0"?>
<robot name="as2_piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================== -->
  <!-- Unitree AS2 Industrial Quadruped Robot with AgileX PiPER Robotic Arm -->
  <!-- Computer Graphics and Vision Lab (CGV) - Isaac Sim 6.2.0 Integration  -->
  <!-- Unified 20-DOF Mobile Manipulator Model                              -->
  <!-- ===================================================================== -->

  <!-- Parameters -->
  <xacro:property name="arm_mount_x" value="0.10" />
  <xacro:property name="arm_mount_y" value="0.0" />
  <xacro:property name="arm_mount_z" value="0.13" />

  <!-- Base Trunk of Unitree AS2 (Industrial Payload 18.5kg) -->
  <link name="base">
    <inertial>
      <origin xyz="0.015 0.0 -0.005" rpy="0 0 0"/>
      <mass value="18.5"/>
      <inertia ixx="0.075" ixy="0.0002" ixz="0.0005" iyy="0.210" iyz="0.00001" izz="0.235"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.22 0.15"/>
      </geometry>
      <material name="matte_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.22 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Mounting plate for PiPER on AS2 Top Deck -->
  <joint name="as2_to_piper_mount" type="fixed">
    <origin xyz="${arm_mount_x} ${arm_mount_y} ${arm_mount_z}" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="arm_base_link"/>
  </joint>

  <!-- AgileX PiPER Arm Base -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.00474 0.000026 0.04145" rpy="0 0 0"/>
      <mass value="0.85"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0013" iyz="0.0" izz="0.0009"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="metallic">
        <color rgba="0.7 0.7 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Base Yaw -->
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.168" effort="100.0" velocity="5.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.07"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -0.1359 -3.1416"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.14" effort="100.0" velocity="5.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.28"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.28"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7939"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="0.0" effort="100.0" velocity="5.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0 -0.12 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.12 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.24"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 -0.12 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.24"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4: Wrist Roll -->
  <joint name="joint4" type="revolute">
    <origin xyz="-0.021984 -0.25075 0" rpy="1.5708 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.745" upper="1.745" effort="100.0" velocity="5.0"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 5: Wrist Pitch -->
  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22" upper="1.22" effort="100.0" velocity="5.0"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 6: Wrist Yaw -->
  <joint name="joint6" type="revolute">
    <origin xyz="0.000088 -0.091 0" rpy="1.5708 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="100.0" velocity="3.0"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Fixed Joint to Gripper Base -->
  <joint name="joint6_to_gripper_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="gripper_base"/>
  </joint>

  <link name="gripper_base">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Finger 1 (Joint 7) -->
  <joint name="joint7" type="prismatic">
    <origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
    <parent link="gripper_base"/>
    <child link="link7"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.035" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="link7">
    <inertial>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.05 0.01"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.05 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Finger 2 (Joint 8) -->
  <joint name="joint8" type="prismatic">
    <origin xyz="0 0 0.04" rpy="1.5708 0 -3.1416"/>
    <parent link="gripper_base"/>
    <child link="link8"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.035" upper="0.0" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="link8">
    <inertial>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.05 0.01"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0.025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.05 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================================================================== -->
  <!-- Unitree AS2 Industrial Quadruped Legs (12 DOF, 95 N.m Peak Torque)   -->
  <!-- ===================================================================== -->

  <!-- FL Leg -->
  <link name="FL_hip">
    <inertial>
      <origin xyz="-0.0054 0.00194 -0.000105" rpy="0 0 0"/>
      <mass value="0.678"/>
      <inertia ixx="0.00048" ixy="-3.01E-06" ixz="1.11E-06" iyy="0.000884" iyz="-1.42E-06" izz="0.000596"/>
    </inertial>
    <visual>
      <origin xyz="0 0.08 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder length="0.04" radius="0.046"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0.08 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder length="0.04" radius="0.046"/></geometry>
    </collision>
  </link>
  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.1934 0.0465 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="FL_hip"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="95.0" velocity="30.1"/>
  </joint>
  <link name="FL_hip_rotor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.089"/>
      <inertia ixx="0.0001118" ixy="0" ixz="0" iyy="0.0000596" iyz="0" izz="0.0000596"/>
    </inertial>
  </link>
  <joint name="FL_hip_rotor_joint" type="fixed">
    <origin xyz="0.11215 0.04675 0" rpy="0 0 0"/>
    <parent link="base"/><child link="FL_hip_rotor"/>
  </joint>

  <link name="FL_thigh">
    <inertial>
      <origin xyz="-0.00374 -0.0223 -0.0327" rpy="0 0 0"/>
      <mass value="1.152"/>
      <inertia ixx="0.00584" ixy="8.72E-05" ixz="-0.000289" iyy="0.0058" iyz="0.000808" izz="0.00103"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 1.5707963 0"/>
      <geometry><box size="0.213 0.0245 0.034"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1065" rpy="0 1.5707963 0"/>
      <geometry><box size="0.213 0.0245 0.034"/></geometry>
    </collision>
  </link>
  <joint name="FL_thigh_joint" type="revolute">
    <origin xyz="0 0.0955 0" rpy="0 0 0"/>
    <parent link="FL_hip"/><child link="FL_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="3.4907" effort="95.0" velocity="30.1"/>
  </joint>
  <link name="FL_thigh_rotor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.089"/>
      <inertia ixx="0.0000596" ixy="0" ixz="0" iyy="0.0001118" iyz="0" izz="0.0000596"/>
    </inertial>
  </link>
  <joint name="FL_thigh_rotor_joint" type="fixed">
    <origin xyz="0 -0.00015 0" rpy="0 0 0"/>
    <parent link="FL_hip"/><child link="FL_thigh_rotor"/>
  </joint>

  <link name="FL_calf">
    <inertial>
      <origin xyz="0.00548 -0.000975 -0.115" rpy="0 0 0"/>
      <mass value="0.154"/>
      <inertia ixx="0.00108" ixy="3.4E-07" ixz="1.72E-05" iyy="0.0011" iyz="8.28E-06" izz="3.29E-05"/>
    </inertial>
    <visual>
      <origin xyz="0.01 0 -0.06" rpy="0 -0.2 0"/>
      <geometry><cylinder length="0.12" radius="0.013"/></geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 -0.06" rpy="0 -0.2 0"/>
      <geometry><cylinder length="0.12" radius="0.013"/></geometry>
    </collision>
  </link>
  <joint name="FL_calf_joint" type="revolute">
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <parent link="FL_thigh"/><child link="FL_calf"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="95.0" velocity="15.70"/>
  </joint>
  <link name="FL_calflower">
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.065" radius="0.011"/></geometry></collision>
  </link>
  <joint name="FL_calflower_joint" type="fixed">
    <origin xyz="0.020 0 -0.148" rpy="0 0.05 0"/>
    <parent link="FL_calf"/><child link="FL_calflower"/>
  </joint>
  <link name="FL_calflower1">
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.03" radius="0.0155"/></geometry></collision>
  </link>
  <joint name="FL_calflower1_joint" type="fixed">
    <origin xyz="-0.01 0 -0.04" rpy="0 0.48 0"/>
    <parent link="FL_calflower"/><child link="FL_calflower1"/>
  </joint>
  <link name="FL_calf_rotor">
    <inertial><origin xyz="0 0 0"/><mass value="0.089"/><inertia ixx="0.0000596" ixy="0" ixz="0" iyy="0.0001118" iyz="0" izz="0.0000596"/></inertial>
  </link>
  <joint name="FL_calf_rotor_joint" type="fixed">
    <origin xyz="0 -0.03235 0" rpy="0 0 0"/>
    <parent link="FL_thigh"/><child link="FL_calf_rotor"/>
  </joint>
  <link name="FL_foot">
    <inertial><origin xyz="0 0 0"/><mass value="0.04"/><inertia ixx="9.6E-06" ixy="0" ixz="0" iyy="9.6E-06" iyz="0" izz="9.6E-06"/></inertial>
    <visual><origin xyz="-0.002 0 0"/><geometry><sphere radius="0.022"/></geometry><material name="matte_black"/></visual>
    <collision><origin xyz="-0.002 0 0"/><geometry><sphere radius="0.022"/></geometry></collision>
  </link>
  <joint name="FL_foot_joint" type="fixed" dont_collapse="true">
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <parent link="FL_calf"/><child link="FL_foot"/>
  </joint>

  <!-- FR Leg -->
  <link name="FR_hip">
    <inertial>
      <origin xyz="-0.0054 -0.00194 -0.000105" rpy="0 0 0"/><mass value="0.678"/>
      <inertia ixx="0.00048" ixy="3.01E-06" ixz="1.11E-06" iyy="0.000884" iyz="-1.42E-06" izz="0.000596"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.08 0" rpy="1.5707963 0 0"/><geometry><cylinder length="0.04" radius="0.046"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.08 0" rpy="1.5707963 0 0"/><geometry><cylinder length="0.04" radius="0.046"/></geometry>
    </collision>
  </link>
  <joint name="FR_hip_joint" type="revolute">
    <origin xyz="0.1934 -0.0465 0" rpy="0 0 0"/>
    <parent link="base"/><child link="FR_hip"/>
    <axis xyz="1 0 0"/><limit lower="-1.0472" upper="1.0472" effort="95.0" velocity="30.1"/>
  </joint>
  <link name="FR_hip_rotor">
    <inertial><origin xyz="0 0 0"/><mass value="0.089"/><inertia ixx="0.0001118" ixy="0" ixz="0" iyy="0.0000596" iyz="0" izz="0.0000596"/></inertial>
  </link>
  <joint name="FR_hip_rotor_joint" type="fixed">
    <origin xyz="0.11215 -0.04675 0" rpy="0 0 0"/>
    <parent link="base"/><child link="FR_hip_rotor"/>
  </joint>

  <link name="FR_thigh">
    <inertial>
      <origin xyz="-0.00374 0.0223 -0.0327" rpy="0 0 0"/><mass value="1.152"/>
      <inertia ixx="0.00584" ixy="-8.72E-05" ixz="-0.000289" iyy="0.0058" iyz="-0.000808" izz="0.00103"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 1.5707963 0"/><geometry><box size="0.213 0.0245 0.034"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1065" rpy="0 1.5707963 0"/><geometry><box size="0.213 0.0245 0.034"/></geometry>
    </collision>
  </link>
  <joint name="FR_thigh_joint" type="revolute">
    <origin xyz="0 -0.0955 0" rpy="0 0 0"/>
    <parent link="FR_hip"/><child link="FR_thigh"/>
    <axis xyz="0 1 0"/><limit lower="-1.5708" upper="3.4907" effort="95.0" velocity="30.1"/>
  </joint>
  <link name="FR_thigh_rotor">
    <inertial><origin xyz="0 0 0"/><mass value="0.089"/><inertia ixx="0.0000596" ixy="0" ixz="0" iyy="0.0001118" iyz="0" izz="0.0000596"/></inertial>
  </link>
  <joint name="FR_thigh_rotor_joint" type="fixed">
    <origin xyz="0 0.00015 0" rpy="0 0 0"/>
    <parent link="FR_hip"/><child link="FR_thigh_rotor"/>
  </joint>

  <link name="FR_calf">
    <inertial>
      <origin xyz="0.00548 0.000975 -0.115" rpy="0 0 0"/><mass value="0.154"/>
      <inertia ixx="0.00108" ixy="-3.4E-07" ixz="1.72E-05" iyy="0.0011" iyz="-8.28E-06" izz="3.29E-05"/>
    </inertial>
    <visual>
      <origin xyz="0.01 0 -0.06" rpy="0 -0.2 0"/><geometry><cylinder length="0.12" radius="0.013"/></geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 -0.06" rpy="0 -0.2 0"/><geometry><cylinder length="0.12" radius="0.013"/></geometry>
    </collision>
  </link>
  <joint name="FR_calf_joint" type="revolute">
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <parent link="FR_thigh"/><child link="FR_calf"/>
    <axis xyz="0 1 0"/><limit lower="-2.7227" upper="-0.83776" effort="95.0" velocity="15.70"/>
  </joint>
  <link name="FR_calflower">
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.065" radius="0.011"/></geometry></collision>
  </link>
  <joint name="FR_calflower_joint" type="fixed">
    <origin xyz="0.020 0 -0.148" rpy="0 0.05 0"/>
    <parent link="FR_calf"/><child link="FR_calflower"/>
  </joint>
  <link name="FR_calflower1">
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.03" radius="0.0155"/></geometry></collision>
  </link>
  <joint name="FR_calflower1_joint" type="fixed">
    <origin xyz="-0.01 0 -0.04" rpy="0 0.48 0"/>
    <parent link="FR_calflower"/><child link="FR_calflower1"/>
