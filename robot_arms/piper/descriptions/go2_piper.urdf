<?xml version="1.0" encoding="utf-8"?>
<robot name="go2_piper">

  <!-- Base Trunk of Unitree Go2 -->
  <link name="base">
    <inertial>
      <origin xyz="0.021112 0.0 -0.005366" rpy="0 0 0"/>
      <mass value="6.921"/>
      <inertia ixx="0.02448" ixy="0.000121" ixz="0.000289" iyy="0.098077" iyz="0.000003" izz="0.107"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.18 0.12"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.18 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Mounting joint for AgileX PiPER arm on Go2 -->
  <joint name="go2_to_piper_mount" type="fixed">
    <origin xyz="0.10 0.0 0.125" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="arm_base_link"/>
  </joint>

  <!-- PiPER Arm Base Link -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.00474 0.000026 0.04145" rpy="0 0 0"/>
      <mass value="0.85"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0013" iyz="0.0" izz="0.0009"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="metallic">
        <color rgba="0.7 0.7 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Base Yaw -->
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.168" effort="100" velocity="5.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.07"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -0.1359 -3.1416"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.14" effort="100" velocity="5.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.28"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.28"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7939"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="0.0" effort="100" velocity="5.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0 -0.12 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.12 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.24"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 -0.12 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.24"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4: Wrist Roll -->
  <joint name="joint4" type="revolute">
    <origin xyz="-0.021984 -0.25075 0" rpy="1.5708 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.745" upper="1.745" effort="100" velocity="5.0"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 5: Wrist Pitch -->
  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22" upper="1.22" effort="100" velocity="5.0"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 6: Wrist Yaw -->
  <joint name="joint6" type="revolute">
    <origin xyz="0.000088 -0.091 0" rpy="1.5708 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="100" velocity="3.0"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Fixed Joint to Gripper Base -->
  <joint name="joint6_to_gripper_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="gripper_base"/>
  </joint>

  <link name="gripper_base">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="metallic"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Finger 1 (Joint 7) -->
  <joint name="joint7" type="prismatic">
    <origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
    <parent link="gripper_base"/>
    <child link="link7"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.035" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="link7">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.04"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Finger 2 (Joint 8) -->
  <joint name="joint8" type="prismatic">
    <origin xyz="0 0 0.04" rpy="1.5708 0 -3.1416"/>
    <parent link="gripper_base"/>
    <child link="link8"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.035" upper="0.0" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="link8">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.04"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.04"/>
      </geometry>
    </collision>
  </link>

</robot>
